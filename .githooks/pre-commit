#!/usr/bin/env bash
# Runs before each commit: blocks it when formatting, linting or tests fail.
# Skip when needed with: git commit --no-verify
set -uo pipefail

# stylua often lives in ~/.cargo/bin outside the default PATH
command -v stylua >/dev/null || export PATH="$HOME/.cargo/bin:$PATH"

fail=0

echo "▸ format-check (stylua)"
if ! make format-check; then
	fail=1
	echo "  ✖ Run 'make format' and re-stage." >&2
fi

echo "▸ lint (luacheck)"
if ! make lint; then
	fail=1
fi

echo "▸ tests (plenary)"
if ! make test; then
	fail=1
fi

if [ "$fail" -ne 0 ]; then
	echo "" >&2
	echo "✖ Commit blocked: fix the issues above." >&2
	echo "  (bypass once with 'git commit --no-verify' — use sparingly)" >&2
	exit 1
fi
